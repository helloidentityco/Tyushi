# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# DATABASE_URL: Neon Serverless PostgreSQL connection string (e.g. postgres://user:pass@ep-xyz.neon.tech/neondb?sslmode=require)
# If not provided, the app will run with a persistent local PostgreSQL engine (PGlite) automatically
DATABASE_URL=""

# Cloudinary configuration for product and collection asset storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Authentication & Admin Setup
AUTH_SECRET="change-this-to-a-secure-random-32-character-secret-key-in-production"
ADMIN_EMAIL="admin@kawishmooi.com"
ADMIN_PASSWORD="AdminPassword2026!"
